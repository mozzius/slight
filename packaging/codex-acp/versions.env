# Pinned inputs for the self-contained Codex ACP bundle.
#
# Every artifact is downloaded from a canonical URL and verified against the
# hash recorded here before it is unpacked. Bump these only through a reviewed
# change that updates the hashes and re-runs the bundle smoke test.
#
# npm tarball URLs are derived as:
#   https://registry.npmjs.org/<scope>/<name>/-/<name>-<version>.tgz
# and verified with sha512 (the npm "integrity" value).
#
# Node tarballs come from https://nodejs.org/dist/v<version>/ and are verified
# with sha256 (the platform SHASUMS256.txt value).

# --- codex-acp broker ---------------------------------------------------------
CODEX_ACP_PATH="@agentclientprotocol/codex-acp"
CODEX_ACP_VERSION="1.11.0"
CODEX_ACP_INTEGRITY="sha512-opPKsRaekgdmQpOpHrR0EEDn9chgtiN+b+h0V78fTuQP84TNzB7vrn3EtKODwbiJQTBHJAlynjSFQazFfaT+VQ=="

# --- Codex (native) ----------------------------------------------------------
OPENAI_CODEX_PATH="@openai/codex"
OPENAI_CODEX_VERSION="0.153.4"

# --- Node runtime ------------------------------------------------------------
NODE_VERSION="24.19.0"

# --- per-target: Node --------------------------------------------------------
# aarch64-apple-darwin
NODE_PLATFORM_AARCH64_APPLE_DARWIN="darwin-arm64"
NODE_SHA256_AARCH64_APPLE_DARWIN="8294b7aa9b03997481c06babf1e8b270c859358f27da57a11509afe537ac381d"
# x86_64-apple-darwin
NODE_PLATFORM_X86_64_APPLE_DARWIN="darwin-x64"
NODE_SHA256_X86_64_APPLE_DARWIN="d1b5e999db158c62fe8f7267a4476b035d8bd93b1a605bac24a3f0dd166e3316"

# --- per-target: @openai/codex platform package ------------------------------
# The platform package is published as @openai/codex with a suffixed version.
CODEX_PLATFORM_VERSION_AARCH64_APPLE_DARWIN="0.153.4-darwin-arm64"
CODEX_PLATFORM_INTEGRITY_AARCH64_APPLE_DARWIN="sha512-B1qhN3fa1ay0R0wGziXqgwSkB5icpYChNKHhtBHff/0UtSTC7z+l8aTtvMlGjH3E8HEvY3+njIJelM9CAAoVWg=="
CODEX_PLATFORM_VERSION_X86_64_APPLE_DARWIN="0.153.4-darwin-x64"
CODEX_PLATFORM_INTEGRITY_X86_64_APPLE_DARWIN="sha512-vnSbbPzfoDZmmyzsxswsDDXQ06IVFBzkQU7/hroB3ji93Ok2utcsq8Psfk2tjF5r9mEx8RWFJhzuTGHG26/NDA=="
